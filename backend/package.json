{
  "name": "geowaste-kilifi-backend",
  "version": "1.0.0",
  "description": "Backend API for GeoKollect geospatial data collection system",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn src/index.ts",
    "build": "tsc",
    "start": "npm run build && node dist/index.js",
    "db:init": "psql -U postgres -d geowaste_kilifi -f ../database/schema.sql",
    "stress-test": "node scripts/stress-test.js",
    "lint": "eslint src/**/*.ts"
  },
  "keywords": [
    "geospatial",
    "waste",
    "kilifi",
    "posture"
  ],
  "author": "GeoWaste Team",
  "license": "MIT",
  "dependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.19",
    "axios": "^1.6.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^6.10.0",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.0",
    "minimatch": "^10.2.5",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^8.0.7",
    "pg": "^8.10.0",
    "tar": "^7.5.15"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/express-rate-limit": "^5.1.3",
    "@types/jsonwebtoken": "^9.0.1",
    "@types/multer": "^1.4.11",
    "@types/node": "^25.6.0",
    "@types/nodemailer": "^6.4.14",
    "@types/pg": "^8.10.7",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "autocannon": "^2.0.1",
    "eslint": "^8.47.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.1.6"
  }
}
