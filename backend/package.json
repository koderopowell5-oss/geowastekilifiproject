{
  "name": "geowaste-kilifi-backend",
  "version": "1.0.0",
  "description": "Backend API for GeoWaste Kilifi geospatial data collection system",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn src/index.ts",
    "build": "tsc",
    "start": "npm run build && node dist/index.js",
    "db:init": "psql -U postgres -d geowaste_kilifi -f ../database/schema.sql",
    "lint": "eslint src/**/*.ts"
  },
  "keywords": [
    "geospatial",
    "waste",
    "kilifi",
    "posture"
  ],
  "author": "GeoWaste Team",
  "license": "MIT",
  "dependencies": {
    "@types/cors": "^2.8.19",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "pg": "^8.10.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/node": "^20.5.0",
    "@types/pg": "^8.10.7",
    "@typescript-eslint/eslint-plugin": "^6.4.1",
    "@typescript-eslint/parser": "^6.4.1",
    "eslint": "^8.47.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.1.6"
  }
}
