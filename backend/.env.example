# Backend Environment Variables
# Copy this file to .env and fill in your actual values

# LOCAL DEVELOPMENT
# NODE_ENV=development
# PORT=5000
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=geowaste_kilifi
# DB_USER=postgres
# DB_PASSWORD=postgres
# CORS_ORIGIN=http://localhost:3000
# API_BASE_URL=http://localhost:5000
# Optional admin login credentials
# ADMIN_USERNAME=kodero_admin
# ADMIN_PASSWORD=*Powell123!
# PRODUCTION (Render)
NODE_ENV=production
PORT=5000

# PostgreSQL Database Configuration (Render)
DB_HOST=dpg-d78fh09r0fns738k6m40-a.frankfurt-postgres.render.com
DB_PORT=5432
DB_NAME=geowaste_kilifi
DB_USER=geowaste
DB_PASSWORD=UYmRtM2J2SuVsxxUJo0TcXCsIrsGfCiO

# CORS
CORS_ORIGIN=*

# API
API_BASE_URL=https://geowaste-api.onrender.com

# EMAIL SERVICE (SMTP)
# Gmail SMTP Configuration
# Note: Use an App Password, not your regular Gmail password
# Generate an app password at: https://myaccount.google.com/apppasswords
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-app-password-here

# Optional explicit SMTP configuration.
# If you want to override the default Gmail service behavior, use these values.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password-here
SMTP_SECURE=true

# Skip email verification while SMTP/email flow is temporarily disabled.
# Set to true to bypass OTP verification and create accounts immediately.
SKIP_EMAIL_VERIFICATION=false

# Fallback email sender address.
SMTP_FROM=your-email@gmail.com

# Cloudinary Configuration (Image Upload)
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
API_VERSION=v1